<Window x:Class="CalendarApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CalendarApp.Models"
        xmlns:vm="clr-namespace:CalendarApp.ViewModels"
        Title="Calendar"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding PreviousCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}"/>
        <KeyBinding Key="T" Command="{Binding TodayCommand}"/>
        <KeyBinding Key="Home" Command="{Binding TodayCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewEventCommand}"/>
        <KeyBinding Key="F2" Command="{Binding EditEventCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteEventCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleThemeCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- ============ A single event, as a chip inside a day cell ============ -->
        <DataTemplate x:Key="EventChipTemplate" DataType="{x:Type models:CalendarEvent}">
            <Border CornerRadius="4"
                    Margin="0,0,0,2"
                    Padding="6,1"
                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                <Border.ToolTip>
                    <StackPanel MaxWidth="260">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RangeLabel}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Notes}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border.ToolTip>
                <TextBlock Text="{Binding Title}"
                           FontSize="11"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>

        <!-- ============ One day of the month grid ============ -->
        <DataTemplate x:Key="DayCellTemplate" DataType="{x:Type vm:DayCellViewModel}">
            <Border x:Name="Cell"
                    Margin="2"
                    CornerRadius="10"
                    Cursor="Hand"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="1.5"
                    SnapsToDevicePixels="True"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.NewEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="Badge"
                            Grid.Row="0"
                            HorizontalAlignment="Left"
                            Margin="5,5,0,3"
                            MinWidth="23"
                            Height="22"
                            Padding="6,0"
                            CornerRadius="11"
                            Background="Transparent">
                        <TextBlock x:Name="DayText"
                                   Text="{Binding DayNumber}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>

                    <ItemsControl Grid.Row="1"
                                  Margin="5,0,5,0"
                                  ItemsSource="{Binding VisibleEvents}"
                                  ItemTemplate="{StaticResource EventChipTemplate}"/>

                    <TextBlock x:Name="Overflow"
                               Grid.Row="2"
                               Margin="9,0,0,5"
                               FontSize="10.5"
                               Text="{Binding HiddenEventLabel}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding HasHiddenEvents, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- Later triggers win, so the order here is the visual priority order. -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource WeekendTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SunkenBrush}"/>
                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                    <Setter TargetName="Overflow" Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                </DataTrigger>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    <Setter TargetName="DayText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ One day inside a year-view thumbnail ============ -->
        <DataTemplate x:Key="MiniDayTemplate" DataType="{x:Type vm:MiniDayViewModel}">
            <Grid Height="21">
                <Border x:Name="Pill"
                        Width="19"
                        Height="17"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="Transparent"/>
                <TextBlock x:Name="Num"
                           Text="{Binding DayNumber}"
                           FontSize="10.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Ellipse x:Name="Dot"
                         Width="4"
                         Height="4"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"
                         Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource WeekendTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasEvents}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                    <Setter TargetName="Num" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ One month thumbnail in the year view ============ -->
        <DataTemplate x:Key="MiniMonthTemplate" DataType="{x:Type vm:MiniMonthViewModel}">
            <Border x:Name="Card"
                    Margin="7"
                    Padding="13,11,13,13"
                    CornerRadius="12"
                    Cursor="Hand"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1.5">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,9"/>
                    <ItemsControl ItemsSource="{Binding DataContext.ShortDayHeaders, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,0,0,3">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource MiniDayTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="6" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ Agenda list ============ -->
        <Style x:Key="AgendaItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AgendaItemTemplate" DataType="{x:Type models:CalendarEvent}">
            <Grid x:Name="Row" Background="Transparent" Margin="10,9,8,9">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="4"
                        CornerRadius="2"
                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>

                <StackPanel Grid.Column="1" Margin="11,0,6,0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding RangeLabel}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Notes}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               MaxHeight="34"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel x:Name="RowActions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Opacity="0">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="28"
                            Height="28"
                            FontSize="12"
                            Content="&#xE70F;"
                            ToolTip="Edit event (F2)"
                            Command="{Binding DataContext.EditEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="28"
                            Height="28"
                            FontSize="12"
                            Content="&#xE74D;"
                            ToolTip="Delete event (Del)"
                            Foreground="{DynamicResource DangerBrush}"
                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Header ===================== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderTitle}"
                           Style="{StaticResource PageTitleTextStyle}"
                           MinWidth="215"/>
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE76B;"
                        Margin="6,0,0,0"
                        ToolTip="{Binding PreviousTooltip}"
                        Command="{Binding PreviousCommand}"/>
                <Button Style="{StaticResource GhostButtonStyle}"
                        Content="Today"
                        Padding="12,6"
                        ToolTip="Jump to today (T)"
                        Command="{Binding TodayCommand}"/>
                <Button Style="{StaticResource IconButtonStyle}"
                        Content="&#xE76C;"
                        ToolTip="{Binding NextTooltip}"
                        Command="{Binding NextCommand}"/>
                <TextBlock Text="{Binding TodayLabel}"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SunkenBrush}"
                        CornerRadius="9"
                        Padding="3"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedItemStyle}"
                                     GroupName="ViewMode"
                                     Content="Month"
                                     IsChecked="{Binding IsMonthView, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource SegmentedItemStyle}"
                                     GroupName="ViewMode"
                                     Content="Year"
                                     IsChecked="{Binding IsYearView, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButtonStyle}"
                        Content="{Binding ThemeIcon}"
                        ToolTip="{Binding ThemeTooltip}"
                        Command="{Binding ToggleThemeCommand}"/>

                <ToggleButton x:Name="SettingsButton"
                              Style="{StaticResource IconToggleButtonStyle}"
                              Content="&#xE713;"
                              ToolTip="Calendar options"/>

                <Popup Placement="Bottom"
                       PlacementTarget="{Binding ElementName=SettingsButton}"
                       HorizontalOffset="-190"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Width="230">
                        <StackPanel>
                            <TextBlock Text="First day of week" Style="{StaticResource FieldLabelTextStyle}"/>
                            <ComboBox ItemsSource="{Binding FirstDayOptions}"
                                      SelectedItem="{Binding FirstDayOfWeek, Mode=TwoWay}"/>
                            <CheckBox Content="Show week numbers"
                                      Margin="0,16,0,0"
                                      IsChecked="{Binding ShowWeekNumbers, Mode=TwoWay}"/>
                            <Border Height="1"
                                    Margin="0,16,0,12"
                                    Background="{DynamicResource SubtleBorderBrush}"/>
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="Shortcuts: arrows to page, T for today, Ctrl+N new event, F2 edit, Del delete, Ctrl+D theme."/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- ===================== Month view ===================== -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="20,0,10,20"
              Visibility="{Binding IsMonthView, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Spacer keeping the day headings aligned with the grid when week numbers show. -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Width="26"
                    Visibility="{Binding ShowWeekNumbers, Converter={StaticResource BoolToVisibility}}"/>

            <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DayHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource DayOfWeekHeaderStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1"
                          Grid.Column="0"
                          Width="26"
                          ItemsSource="{Binding WeekNumbers}"
                          Visibility="{Binding ShowWeekNumbers, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource WeekNumberTextStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding Days}"
                          ItemTemplate="{StaticResource DayCellTemplate}"
                          SizeChanged="MonthGrid_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- ===================== Year view ===================== -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                      Margin="13,0,3,20"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsYearView, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Months}" ItemTemplate="{StaticResource MiniMonthTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===================== Agenda ===================== -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Width="330"
                Margin="10,0,20,20"
                CornerRadius="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,17,18,12">
                    <TextBlock Text="{Binding SelectedDayTitle}" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding SelectedDayRelative}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Row="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="18,0,18,14"
                        Content="Add event"
                        ToolTip="Add an event to this day (Ctrl+N)"
                        Command="{Binding NewEventCommand}"/>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding SelectedDayEvents}"
                             SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource AgendaItemStyle}"
                             ItemTemplate="{StaticResource AgendaItemTemplate}"
                             Margin="10,0,10,12"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasSelectedDayEvents, Converter={StaticResource BoolToVisibility}}"/>

                    <StackPanel VerticalAlignment="Center"
                                Margin="28,0,28,40"
                                Visibility="{Binding HasSelectedDayEvents, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Nothing planned"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="Double-click a day, or use the button above, to add something."
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
