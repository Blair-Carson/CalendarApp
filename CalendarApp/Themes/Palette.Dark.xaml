<!--
    Dark palette. Must define exactly the same keys as Palette.Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15171C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2127"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#232730"/>
    <SolidColorBrush x:Key="SunkenBrush" Color="#191C22"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#39414F"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2B313C"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2E3A52"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EAEE"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6AEBC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5E6675"/>
    <SolidColorBrush x:Key="WeekendTextBrush" Color="#7B8494"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6E9BF2"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A79D6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#243149"/>

    <!-- Lines and state -->
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2C313A"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#3B424E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E8637A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3E4551"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#525B69"/>

</ResourceDictionary>
