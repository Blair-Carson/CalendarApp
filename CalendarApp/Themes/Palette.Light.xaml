<!--
    Light palette. Colour resources ONLY: every control style lives in Styles.xaml and
    reaches these through DynamicResource, so swapping this dictionary re-themes the app
    without touching the visual tree.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="SunkenBrush" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E9EEF9"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCE7FB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F26"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#545C6B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A6ADBA"/>
    <SolidColorBrush x:Key="WeekendTextBrush" Color="#8A93A3"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2560D8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E4FB8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EDFE"/>

    <!-- Lines and state -->
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#C9CFD8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D9455F"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2C8D2"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A3ABB8"/>

</ResourceDictionary>
